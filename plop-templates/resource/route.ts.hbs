import { NextRequest, NextResponse } from "next/server";

import { {{camelCase name}}Store } from "@/app/api/{{name}}/_data";

export async function GET(req: NextRequest) {
  const sp = req.nextUrl.searchParams;
  const page = Number(sp.get("page") ?? "1");
  const perPage = Number(sp.get("per_page") ?? "10");
  const q = sp.get("q") ?? "";
  const sort = sp.get("sort") ?? undefined;
  const order = sp.get("order") === "desc" ? "desc" : "asc";
  return NextResponse.json({{camelCase name}}Store.list({ page, perPage, q, sort, order }));
}

export async function POST(req: NextRequest) {
  const body = await req.json();
  const created = {{camelCase name}}Store.create({ id: `{{name}}-${Date.now()}`, ...body });
  return NextResponse.json(created, { status: 201 });
}
