{
  "name": "adminly",
  "version": "0.1.0",
  "private": true,
  "description": "Starter dashboard generik untuk internal tool — Next.js 16, React 19, Tailwind v4, shadcn/ui (Base UI). Siap di-fork tiap project baru.",
  "license": "MIT",
  "author": "zihar",
  "homepage": "https://github.com/zihar/adminly#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zihar/adminly.git"
  },
  "bugs": {
    "url": "https://github.com/zihar/adminly/issues"
  },
  "keywords": [
    "nextjs",
    "react",
