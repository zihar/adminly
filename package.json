    "starter",
    "boilerplate",
    "template"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "gen:api": "openapi-typescript openapi.yaml -o src/lib/api/schema.d.ts",
    "gen:resource": "plop resource",
